-- // 2. РАДУЖНЫЙ РАДИУС (ПОСТОЯННЫЙ + workspace.Towers.Part)
-- // ------------------------------------------------------------
-- Работает всегда, пока открыта башня или выбирается точка установки.
-- Если точка запрещена (красный цвет 255, 51, 51) — радуга тормозится на красном.

RunService.RenderStepped:Connect(function()
    if not State.RainbowRadius then return end
    local rainbow = Color3.fromHSV((tick() * 0.7) % 1, 1, 1)

    -- 1. Радиус выбранной башни (workspace.Towers.Part)
    local tFolder = Workspace:FindFirstChild("Towers")
    if tFolder then
        local tPart = tFolder:FindFirstChild("Part")
        if tPart and tPart:IsA("BasePart") then
            tPart.Color = rainbow
        end
        local touchRad = tFolder:FindFirstChild("TouchRadius")
        if touchRad then
            for _, rPart in ipairs(touchRad:GetChildren()) do
                if rPart:IsA("BasePart") then rPart.Color = rainbow end
            end
        end
    end

    -- 2. Радиус при установке башни в пространстве
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= lp.Character and obj.Name ~= "Towers" and obj.Name ~= "Monsters" then
            local rPart = obj:FindFirstChild("Part") or obj:FindFirstChild("TouchPart") or obj:FindFirstChild("RadiusPart")
            if rPart and rPart:IsA("BasePart") then
                local r, g, b = rPart.Color.R * 255, rPart.Color.G * 255, rPart.Color.B * 255
                -- Проверка на красный цвет запрета установки (Persimmon)
                if r > 190 and g < 100 and b < 100 then
                    -- Оставляем красный
                else
                    rPart.Color = rainbow
                end
            end
        end
    end
end)

