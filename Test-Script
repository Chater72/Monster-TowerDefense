local function getCurrentWave()
    local mainGui = pgui:FindFirstChild("MainGui")
    local waveLbl = mainGui
        and mainGui:FindFirstChild("LevelFrame")
        and mainGui.LevelFrame:FindFirstChild("stats")
        and mainGui.LevelFrame.stats:FindFirstChild("Wave")
        and mainGui.LevelFrame.stats.Wave:FindFirstChild("Counter")
    if waveLbl and waveLbl.Text then
        local w = tonumber(waveLbl.Text:match("(%d+)/")) or tonumber(waveLbl.Text:match("(%d+)"))
        if w then return w end
    end
    return 1
end

local function getTowerBuildCost(towerName)
    local data = towerStatsCache[towerName]
    if data and data.price then return data.price end
    return 100
end

local function triggerSkip()
    local mainGui = pgui:FindFirstChild("MainGui")
    local startBtn = mainGui
        and mainGui:FindFirstChild("LevelFrame")
        and mainGui.LevelFrame:FindFirstChild("NextWaveInfo")
        and mainGui.LevelFrame.NextWaveInfo:FindFirstChild("StartFrame")
        and mainGui.LevelFrame.NextWaveInfo.StartFrame:FindFirstChild("Start")
    if startBtn and startBtn.Visible then fireClick(startBtn) end
end

local function findTowerNear(x, z, maxDist)
    if not SharedClass then return nil end
    local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
    if not tpFolder then return nil end
    local bestObj = nil
    local minDist = maxDist or 6

    for _, tp in ipairs(tpFolder:GetChildren()) do
        local uid = tp:GetAttribute("uid")
        if uid then
            local obj = SharedClass.GetById(uid)
            if obj and obj.isOwner and obj.position then
                local dist = math.sqrt((obj.position.X - x)^2 + (obj.position.Z - z)^2)
                if dist < minDist then
                    minDist = dist
                    bestObj = obj
                end
            end
        end
    end
    return bestObj
end

local function startRecording()
    MacroActions = {}
    TrackedTowers = {}
    nextMacroIdCounter = 1
    State.MacroRecording = true
    State.MacroPlaying = false

    local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
    if tpFolder and SharedClass then
        for _, tp in ipairs(tpFolder:GetChildren()) do
            local uid = tp:GetAttribute("uid")
            if uid then
                local obj = SharedClass.GetById(uid)
                if obj and obj.isOwner and obj.position then
                    local id = nextMacroIdCounter
                    nextMacroIdCounter = nextMacroIdCounter + 1
                    TrackedTowers[uid] = {
                        macroId = id,
                        name = obj.name,
                        x = obj.position.X,
                        z = obj.position.Z,
                        star = obj.starCount or 0
                    }
                    table.insert(MacroActions, {
                        type = "BUILD",
                        macroId = id,
                        name = obj.name,
                        x = obj.position.X,
                        z = obj.position.Z,
                        wave = getCurrentWave()
                    })
                end
            end
        end
    end
end

local function stopRecording()
    State.MacroRecording = false
end

local function startPlayback()
    if #MacroActions == 0 then
        StatusPlaybackText = "⚠️ Макрос пуст! Сначала запишите или загрузите."
        return
    end
    PlaybackTowerMap = {}
    currentActionIndex = 1
    State.MacroPlaying = true
    State.MacroRecording = false
    StatusPlaybackText = "▶️ Воспроизведение запущено..."
end

local function stopPlayback()
    State.MacroPlaying = false
    StatusPlaybackText = "⏹️ Воспроизведение остановлено."
end

local function saveMacroToFile()
    if #MacroActions == 0 then return false, "Макрос пуст!" end
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, MacroActions)
    if ok and encoded then
        writefile(State.MacroFile, encoded)
        return true, "Сохранено " .. #MacroActions .. " действий в " .. State.MacroFile
    end
    return false, "Ошибка JSON"
end

local function loadMacroFromFile()
    local rf = rawget(getgenv and getgenv() or _G, "readfile") or readfile
    local isf = rawget(getgenv and getgenv() or _G, "isfile") or isfile
    if not isf(State.MacroFile) then return false, "Файл не найден!" end
    local content = rf(State.MacroFile)
    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, content)
    if ok and decoded and type(decoded) == "table" then
        MacroActions = decoded
        return true, "Загружено " .. #MacroActions .. " действий из " .. State.MacroFile
    end
    return false, "Ошибка парсинга JSON"
end

-- Цикл записи башен
task.spawn(function()
    while true do
        task.wait(0.2)
        if State.MacroRecording and SharedClass then
            local currentWave = getCurrentWave()
            local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
            local activeUids = {}

            if tpFolder then
                for _, tp in ipairs(tpFolder:GetChildren()) do
                    local uid = tp:GetAttribute("uid")
                    if uid then
                        local obj = SharedClass.GetById(uid)
                        if obj and obj.isOwner and obj.position then
                            activeUids[uid] = true

                            if not TrackedTowers[uid] then
                                local id = nextMacroIdCounter
                                nextMacroIdCounter = nextMacroIdCounter + 1
                                TrackedTowers[uid] = {
                                    macroId = id,
                                    name = obj.name,
                                    x = obj.position.X,
                                    z = obj.position.Z,
                                    star = obj.starCount or 0
                                }
                                table.insert(MacroActions, {
                                    type = "BUILD",
                                    macroId = id,
                                    name = obj.name,
                                    x = obj.position.X,
                                    z = obj.position.Z,
                                    wave = currentWave
                                })
                            else
                                local tracked = TrackedTowers[uid]
                                local curStar = obj.starCount or 0
                                if curStar > tracked.star then
                                    tracked.star = curStar
                                    table.insert(MacroActions, {
                                        type = "UPGRADE_STAR",
                                        macroId = tracked.macroId,
                                        star = curStar,
                                        wave = currentWave
                                    })
                                end
                            end
                        end
                    end
                end
            end

            for uid, tracked in pairs(TrackedTowers) do
                if not activeUids[uid] then
                    table.insert(MacroActions, {
                        type = "SELL",
                        macroId = tracked.macroId,
                        wave = currentWave
                    })
                    TrackedTowers[uid] = nil
                end
            end
        end
    end
end)

-- Цикл выполнения макроса
task.spawn(function()
    while true do
        task.wait(0.35)
        if State.MacroPlaying then
            if currentActionIndex > #MacroActions then
                StatusPlaybackText = "✅ Все действия выполнены!"
                if State.MacroAutoLoop and getCurrentWave() == 1 and currentActionIndex > 1 then
                    task.wait(2)
                    startPlayback()
                end
            else
                local action = MacroActions[currentActionIndex]
                local curWave = getCurrentWave()
                local curMoney = getMoney()

                if curWave < action.wave then
                    StatusPlaybackText = string.format("⏳ Ожидание волны %d (текущая: %d) [%d/%d]", action.wave, curWave, currentActionIndex, #MacroActions)
                else
                    if action.type == "BUILD" then
                        local cost = getTowerBuildCost(action.name)
                        if curMoney < cost then
                            StatusPlaybackText = string.format("💰 Копим на %s: $%d / $%d (волна %d)", action.name, curMoney, cost, action.wave)
                        else
                            StatusPlaybackText = string.format("🔨 Строим %s на (%.0f, %.0f)...", action.name, action.x, action.z)
                            local tb = ReplicatedStorage.channels:FindFirstChild("TowerBuilding")
                            if tb then
                                tb:FireServer(Vector2.new(action.x, action.z), action.name)
                            end
                            task.wait(0.5)

                            local newTower = findTowerNear(action.x, action.z, 6)
                            if newTower then
                                PlaybackTowerMap[action.macroId] = newTower
                            end
                            currentActionIndex = currentActionIndex + 1
                        end
                    elseif action.type == "UPGRADE_STAR" then
                        local targetTower = PlaybackTowerMap[action.macroId]
                        if not targetTower or targetTower.isDestroyed then
                            targetTower = findTowerNear(action.x or 0, action.z or 0, 10)
                        end

                        if not targetTower or targetTower.isDestroyed then
                            currentActionIndex = currentActionIndex + 1
                        else
                            local starCost = targetTower.priceHandler and targetTower.priceHandler:GetStarCost() or 150
                            if curMoney < starCost then
                                StatusPlaybackText = string.format("💰 Копим на апгрейд #%d: $%d / $%d (волна %d)", action.macroId, curMoney, starCost, action.wave)
                            else
                                StatusPlaybackText = string.format("⚡ Апгрейд башни #%d (звезда %d)...", action.macroId, action.star)
                                doUpgrade(targetTower.model)
                                task.wait(0.4)
                                currentActionIndex = currentActionIndex + 1
                            end
                        end
                    elseif action.type == "SELL" then
                        local targetTower = PlaybackTowerMap[action.macroId]
                        if targetTower and not targetTower.isDestroyed then
                            StatusPlaybackText = string.format("🗑️ Продаем башню #%d (волна %d)...", action.macroId, action.wave)
                            doSell(targetTower.model)
                            task.wait(0.3)
                        end
                        currentActionIndex = currentActionIndex + 1
                    elseif action.type == "SKIP" then
                        StatusPlaybackText = string.format("⏩ Скипаем волну %d...", action.wave)
                        triggerSkip()
                        task.wait(0.3)
                        currentActionIndex = currentActionIndex + 1
                    end
                end
            end
        end
    end
end)

