local function getClosestTower(maxDist)
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local towers = Workspace:FindFirstChild("Towers")
    if not towers then return nil end

    local closest, minDist = nil, maxDist or 15
    for _, t in ipairs(towers:GetChildren()) do
        if t:IsA("Model") and t.Name ~= "TouchParts" and t.Name ~= "TouchRadius" and t.Name ~= "Roots" then
            local part = t:FindFirstChild("HumanoidRootPart") or t:FindFirstChildOfClass("BasePart")
            if part then
                local dist = (part.Position - root.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closest = t
                end
            end
        end
    end
    return closest
end

