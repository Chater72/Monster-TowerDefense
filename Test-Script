-- // Safe tower sell (Auto remove without getting stuck)
local function doSell(targetModel)
    if not targetModel then return false end

    -- 1. Call sell directly via SharedClass object
    local towerObj = nil
    if SharedClass then
        local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
        if tpFolder then
            for _, tp in ipairs(tpFolder:GetChildren()) do
                local uid = tp:GetAttribute("uid")
                if uid then
                    local obj = SharedClass.GetById(uid)
                    if obj and (obj.model == targetModel or obj.instance == targetModel) then
                        towerObj = obj
                        break
                    end
                end
            end
        end
    end

    if towerObj and towerObj.RemoteCall then
        pcall(function()
            towerObj:RemoteCall("Sell")
        end)
    end

    -- 2. Client UI: select tower and click sell button
    selectTower(targetModel)
    task.wait(0.02)

    local mainGui = pgui:FindFirstChild("MainGui")
    if mainGui then
        local tm = mainGui:FindFirstChild("TowerModule", true)
        local tmMod = tm and require(tm)
        if tmMod and tmMod.SellTower then
            task.spawn(function()
                pcall(tmMod.SellTower)
            end)
        end

        local sellBtn = mainGui:FindFirstChild("TowerFrame") and mainGui.TowerFrame:FindFirstChild("SellButton")
        if sellBtn then fireClick(sellBtn) end

        -- Verify ActionPrompt ONLY if it is a tower sell confirmation dialog
        task.wait(0.04)
        local prompt = mainGui:FindFirstChild("ActionPrompt")
        if prompt and prompt.Visible then
            local txt = prompt:FindFirstChild("Tooltip") and prompt.Tooltip:FindFirstChild("Text") and prompt.Tooltip.Text.Text or ""
            local lowerTxt = string.lower(txt)
            if string.find(lowerTxt, "продать") or string.find(lowerTxt, "sell") or string.find(lowerTxt, "башн") then
                local am = prompt:FindFirstChild("ActionModule")
                if am then
                    pcall(function()
                        local mod = require(am)
                        if mod.waiting then
                            mod.waiting = nil
                            mod.result = true
                        end
                    end)
                end
                if _G.ActionModule and _G.ActionModule.waiting then
                    _G.ActionModule.waiting = nil
                    _G.ActionModule.result = true
                end
                prompt.Visible = false
            end
        end

        if tmMod and tmMod.Disable then
            pcall(tmMod.Disable)
        end
    end
    return true
end

-- // Calculate total upgrade cost and sell value of all towers
local function getTowersFinancials()
    if not SharedClass then return 0, 0, 0, 0 end
    local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
    if not tpFolder then return 0, 0, 0, 0 end

    local totalSell = 0
    local totalUpgrade = 0
    local ownedCount = 0
    local upgradableCount = 0

    for _, tp in ipairs(tpFolder:GetChildren()) do
        local uid = tp:GetAttribute("uid")
        if uid then
            local obj = SharedClass.GetById(uid)
            if obj and obj.isOwner then
                ownedCount = ownedCount + 1
                totalSell = totalSell + (obj.costSell or 0)

                local nextStar = (obj.starCount or 0) + 1
                local data = towerStatsCache[obj.name]
                if data then
                    local sData = data["star" .. nextStar]
                    if sData and sData.cost then
                        totalUpgrade = totalUpgrade + sData.cost
                        upgradableCount = upgradableCount + 1
                    end
                end
            end
        end
    end
    return totalUpgrade, totalSell, ownedCount, upgradableCount
end

