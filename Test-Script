local function fireClick(btn)
    if not btn then return end
    if btn:IsA("Frame") then
        btn = btn:FindFirstChild("Button") or btn:FindFirstChildOfClass("TextButton") or btn:FindFirstChildOfClass("ImageButton") or btn
    end
    if not (btn:IsA("TextButton") or btn:IsA("ImageButton")) then return end
    local firesig = rawget(getgenv and getgenv() or _G, "firesignal")
    if firesig then
        pcall(firesig, btn.MouseButton1Click)
        pcall(firesig, btn.Activated)
    else
        for _, c in pairs(getconnections(btn.MouseButton1Click)) do pcall(c.Fire, c) end
        for _, c in pairs(getconnections(btn.Activated)) do pcall(c.Fire, c) end
    end
end

local function parseNumber(str)
    if not str then return 0 end
    local cleaned = str:gsub("%D+", "")
    return tonumber(cleaned) or 0
end

local function getMoney()
    local mainGui = pgui:FindFirstChild("MainGui")
    local counter = mainGui and mainGui:FindFirstChild("MoneyFrame") and mainGui.MoneyFrame:FindFirstChild("moneyCounter")
    return counter and parseNumber(counter.Text) or 0
end

local function getUpgradeCost()
    local mainGui = pgui:FindFirstChild("MainGui")
    local upg = mainGui and mainGui:FindFirstChild("TowerFrame")
        and mainGui.TowerFrame:FindFirstChild("FrameUpgrader")
        and mainGui.TowerFrame.FrameUpgrader:FindFirstChild("FrameStars")
        and mainGui.TowerFrame.FrameUpgrader.FrameStars:FindFirstChild("upgrade")
    local costLbl = upg and upg:FindFirstChild("cost")
    return costLbl and parseNumber(costLbl.Text) or 0
end

local function selectTower(targetModel)
    if not targetModel or not SharedClass or not WorldClickingService then return false end
    local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
    if not tpFolder then return false end

    for _, tp in ipairs(tpFolder:GetChildren()) do
        local uid = tp:GetAttribute("uid")
        if uid then
            local obj = SharedClass.GetById(uid)
            if obj and (obj.model == targetModel or obj.instance == targetModel) then
                pcall(function()
                    WorldClickingService.Select(obj)
                end)
                return true
            end
        end
    end
    return false
end

