local currentEmotionTrack = nil

local function setEmotion(name, active, speed)
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")

    if active and anim then
        if currentEmotionTrack then currentEmotionTrack:Stop() end
        local a = Instance.new("Animation")
        a.AnimationId = AnimationIds[name] or AnimationIds.Wave
        currentEmotionTrack = anim:LoadAnimation(a)
        currentEmotionTrack.Looped = true
        currentEmotionTrack:Play()
        currentEmotionTrack:AdjustSpeed(speed or 1)
    else
        if currentEmotionTrack then
            currentEmotionTrack:Stop()
            currentEmotionTrack = nil
        end
    end
end

