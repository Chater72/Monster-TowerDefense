local function updateMachineGuns()
    local towers = Workspace:FindFirstChild("Towers")
    if not towers then return end

    for _, t in ipairs(towers:GetChildren()) do
        for mgName, _ in pairs(MG_MODELS) do
            if t.Name:find(mgName) then
                if State.CustomMG then
                    hideNativeMGParts(t)

                    local template = loadedMGAssets[mgName]
                    local upPart = t:FindFirstChild("Up") or t:FindFirstChild("Gun") or t:FindFirstChild("HumanoidRootPart")
                    local sentry = t:FindFirstChild("CustomSentryRig")

                    if template and upPart and not sentry then
                        sentry = template:Clone()
                        sentry.Name = "CustomSentryRig"

                        local cf, _ = sentry:GetBoundingBox()
                        local rootPart = Instance.new("Part")
                        rootPart.Name = "SentryRoot"
                        rootPart.Size = Vector3.new(1, 1, 1)
                        rootPart.Transparency = 1
                        rootPart.CanCollide = false
                        rootPart.Anchored = true
                        rootPart.CFrame = cf
                        rootPart.Parent = sentry
                        sentry.PrimaryPart = rootPart

                        for _, p in ipairs(sentry:GetDescendants()) do
                            if p:IsA("BasePart") then
                                p.CanCollide = false
                                p.CanTouch = false
                                p.CanQuery = false
                                p.Massless = true
                                p.Anchored = true
                            end
                        end

                        sentry.Parent = t

                        local heightOffset = State.SentryHeight or 2.8
                        local rotOffset = math.rad(State.SentryRotation or 180)
                        sentry:PivotTo(upPart.CFrame * CFrame.new(0, heightOffset, 0) * CFrame.Angles(0, rotOffset, 0))
                    end
                else
                    local sentry = t:FindFirstChild("CustomSentryRig")
                    if sentry then sentry:Destroy() end
                    showNativeMGParts(t)
                end
            end
        end
    end
end

