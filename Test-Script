    if not targetModel or not SharedClass or not WorldClickingService then return false end
    local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
    if not tpFolder then return false end

    for _, tp in ipairs(tpFolder:GetChildren()) do
        local uid = tp:GetAttribute("uid")
        if uid then
            local obj = SharedClass.GetById(uid)
            if obj and (obj.model == targetModel or obj.instance == targetModel) then
                pcall(function()
                    WorldClickingService.Select(obj)
                end)
