local function setTowerScale(model, scale)
    if not model or not model:IsA("Model") then return end
    if not model.PrimaryPart then
        model.PrimaryPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildOfClass("BasePart")
    end
    if model.PrimaryPart then
        pcall(function() model:ScaleTo(scale) end)
    end
end

local function updateTowerVisuals()
    local tFolder = Workspace:FindFirstChild("Towers")
    if not tFolder then return end

    for _, obj in ipairs(tFolder:GetChildren()) do
        if obj:IsA("Model") and obj.Name ~= "TouchParts" and obj.Name ~= "TouchRadius" and obj.Name ~= "Roots" then
            if not obj.PrimaryPart then
                obj.PrimaryPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart")
            end

            -- 1. Tower Sizing
            local targetScale = State.TowerSizing and State.TowerSizeValue or 1
            setTowerScale(obj, targetScale)

            -- 2. Tower Outlines
            local h = obj:FindFirstChild("TowerOutline")
            if State.TowerOutlines then
                if not h then
                    h = Instance.new("Highlight")
                    h.Name = "TowerOutline"
                    h.Parent = obj
                end
                h.FillTransparency = 1
                h.OutlineColor = Color3.fromRGB(255, 170, 0)
            else
                if h then h:Destroy() end
            end

            -- 3. Tower Visual Effects
            local f = obj.PrimaryPart and obj.PrimaryPart:FindFirstChild("TowerFire")
            if State.TowerEffects and obj.PrimaryPart then
                if not f then
                    f = Instance.new("Fire")
                    f.Name = "TowerFire"
                    f.Size = 6
                    f.Heat = 10
                    f.Parent = obj.PrimaryPart
                end
            else
                if f then f:Destroy() end
            end
        end
    end
end

