local function destroyDrone(seat)
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or not seat then return end

    local oldPos = root.CFrame
    local orgHeight = Workspace.FallenPartsDestroyHeight

    root.CFrame = seat.CFrame * CFrame.new(0, 1.8, 0)
    task.wait(0.08)
    pcall(seat.Sit, seat, hum)

    local startSit = tick()
    while seat.Occupant ~= hum and (tick() - startSit) < 0.6 do
        task.wait(0.03)
    end

    Workspace.FallenPartsDestroyHeight = 0/1/0
    root.CFrame = CFrame.new(Vector3.new(0, orgHeight - 40, 0))
    task.wait(0.4)

    hum.Jump = true
    task.wait(0.06)

    root.CFrame = oldPos
    Workspace.FallenPartsDestroyHeight = orgHeight
end

local function autoDestroyOtherDrones()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if (obj:IsA("Seat") or obj:IsA("VehicleSeat")) and not obj.Occupant then
            destroyDrone(obj)
            break
        elseif obj:IsA("Model") and obj ~= lp.Character and obj ~= myDroneModel then
            for _, sub in ipairs(obj:GetChildren()) do
                if (sub:IsA("Seat") or sub:IsA("VehicleSeat")) and not sub.Occupant then
                    destroyDrone(sub)
                    break
                end
            end
        end
    end
end

