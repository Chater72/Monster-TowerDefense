-- Отслеживание прогресса волны
local maxMonstersSeen = 0
local lastMonsterSpawnTick = tick()
local previousMonsterCount = 0

task.spawn(function()
    while true do
        task.wait(0.12)
        local mFolder = Workspace:FindFirstChild("Monsters")
        local currentMonsters = 0
        if mFolder then
            for _, m in ipairs(mFolder:GetChildren()) do
                if m:IsA("Model") and m.Name ~= "TouchParts" then
                    currentMonsters = currentMonsters + 1
                end
            end
        end

        -- Новые монстры появились
        if currentMonsters > previousMonsterCount then
            lastMonsterSpawnTick = tick()
            if currentMonsters > maxMonstersSeen then
                maxMonstersSeen = currentMonsters
            end
        end
        previousMonsterCount = currentMonsters

        -- Логика отображения
        if currentMonsters == 0 then
            pLabel.Text = "100% Complete"
            maxMonstersSeen = 0
        else
            -- Если 3 секунды никто не спавнился — значит остались последние
            if (tick() - lastMonsterSpawnTick) >= 3 and maxMonstersSeen > 0 then
                local pct = math.clamp(math.floor(((maxMonstersSeen - currentMonsters) / maxMonstersSeen) * 100), 0, 99)
                pLabel.Text = tostring(pct) .. "% Complete"
            else
                pLabel.Text = "0% Complete"
            end
        end

        -- Автонажатие кнопки старта
        if State.AutoSkip then
            pcall(function()
                local mainGui = pgui:FindFirstChild("MainGui")
                local startBtn = mainGui.LevelFrame.NextWaveInfo.StartFrame.Start
                if startBtn and (startBtn.Visible or startBtn.Parent.Visible) then
                    local firesig = rawget(getgenv and getgenv() or _G, "firesignal")
                    if firesig then
                        firesig(startBtn.MouseButton1Click)
                        firesig(startBtn.Activated)
                    else
                        for _, c in pairs(getconnections(startBtn.MouseButton1Click)) do c:Fire() end
                        for _, c in pairs(getconnections(startBtn.Activated)) do c:Fire() end
                    end
                end
            end)
        end
    end
end)

