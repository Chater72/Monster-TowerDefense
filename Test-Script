local activeBillboards = {}

local function updateTowerHelper()
    if not State.TowerHelper then
        for _, b in pairs(activeBillboards) do b:Destroy() end
        activeBillboards = {}
        return
    end

    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local towers = Workspace:FindFirstChild("Towers")
    if not towers then return end

    for _, t in ipairs(towers:GetChildren()) do
        if t:IsA("Model") and t:FindFirstChild("HumanoidRootPart") then
            local dist = (t.HumanoidRootPart.Position - root.Position).Magnitude
            local bb = activeBillboards[t]

            if dist <= 10 then
                if not bb then
                    bb = Instance.new("BillboardGui")
                    bb.Name = "TH_Billboard"
                    bb.Size = UDim2.new(0, 170, 0, 42)
                    bb.StudsOffset = Vector3.new(0, 7.5, 0) -- Высоко над башней!
                    bb.AlwaysOnTop = true
                    bb.Active = true
                    bb.Adornee = t.HumanoidRootPart
                    bb.Parent = helperGui

                    local bUpg = Instance.new("TextButton")
                    bUpg.Size = UDim2.new(0, 80, 1, 0)
                    bUpg.Position = UDim2.new(0, 0, 0, 0)
                    bUpg.BackgroundColor3 = Color3.fromRGB(30, 165, 65)
                    bUpg.TextColor3 = Color3.fromRGB(255, 255, 255)
                    bUpg.Font = Enum.Font.GothamBold
                    bUpg.TextSize = 11
                    bUpg.Text = "UPGRADE"
                    bUpg.Active = true
                    bUpg.Parent = bb
                    Instance.new("UICorner", bUpg).CornerRadius = UDim.new(0, 6)

                    local bSell = Instance.new("TextButton")
                    bSell.Size = UDim2.new(0, 80, 1, 0)
                    bSell.Position = UDim2.new(0, 90, 0, 0)
                    bSell.BackgroundColor3 = Color3.fromRGB(205, 40, 40)
                    bSell.TextColor3 = Color3.fromRGB(255, 255, 255)
                    bSell.Font = Enum.Font.GothamBold
                    bSell.TextSize = 11
                    bSell.Text = "SELL"
                    bSell.Active = true
                    bSell.Parent = bb
                    Instance.new("UICorner", bSell).CornerRadius = UDim.new(0, 6)

                    bUpg.Activated:Connect(function()
                        doUpgrade()
                    end)

                    bSell.Activated:Connect(function()
                        doSell()
                    end)

                    activeBillboards[t] = bb
                end
            else
                if bb then
                    bb:Destroy()
                    activeBillboards[t] = nil
                end
            end
        end
    end
end

