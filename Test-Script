local function hideNativeMGParts(t)
    for _, d in ipairs(t:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Decal")) and not d:IsDescendantOf(t:FindFirstChild("CustomSentryRig") or Workspace) then
            d.Transparency = 1
        end
    end
end

local function showNativeMGParts(t)
    for _, d in ipairs(t:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Decal")) and not d:IsDescendantOf(t:FindFirstChild("CustomSentryRig") or Workspace) then
            if d.Name ~= "HumanoidRootPart" then
                d.Transparency = 0
            end
        end
    end
