        local m = ls:FindFirstChild("Money") or ls:FindFirstChild("Silver")
        if m and m:IsA("ValueBase") then return m.Value end
    end
    local attr = p:GetAttribute("Silver") or p:GetAttribute("Money")
    if attr ~= nil then return attr end
    return 0
end

