local function getMoney()
    local counter = pgui.MainGui.MoneyFrame:FindFirstChild("moneyCounter")
    return counter and (tonumber(counter.Text:gsub("%D+", "")) or 0) or 0
end

local function getUpgradeCost()
    local upg = pgui.MainGui.TowerFrame.FrameUpgrader.FrameStars.upgrade
    local costLbl = upg and upg:FindFirstChild("cost")
    return costLbl and (tonumber(costLbl.Text:gsub("%D+", "")) or 0) or 0
end

local function getSellPrice()
    local sell = pgui.MainGui.TowerFrame:FindFirstChild("SellButton")
    local priceLbl = sell and sell:FindFirstChild("price")
    return priceLbl and (tonumber(priceLbl.Text:gsub("%D+", "")) or 0) or 0
end

local function doUpgrade()
    local upgBtn = pgui.MainGui.TowerFrame.FrameUpgrader.FrameStars.upgrade
    if upgBtn and getMoney() >= getUpgradeCost() then
        for _, c in pairs(getconnections(upgBtn.MouseButton1Click)) do c:Fire() end
        for _, c in pairs(getconnections(upgBtn.Activated)) do c:Fire() end
        return true
    end
    return false
end

local function doSell()
    local sellBtn = pgui.MainGui.TowerFrame:FindFirstChild("SellButton")
    if sellBtn then
        for _, c in pairs(getconnections(sellBtn.MouseButton1Click)) do c:Fire() end
        for _, c in pairs(getconnections(sellBtn.Activated)) do c:Fire() end
    end
end

