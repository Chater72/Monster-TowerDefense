-- // 4. КАСТОМНЫЕ МОДЕЛИ MACHINEGUN (ПО МЕШ АЙДИ)
-- // ------------------------------------------------------------
local function updateMachineGuns()
    if not State.CustomMG then return end
    local towers = Workspace:FindFirstChild("Towers")
    if not towers then return end

    for _, t in ipairs(towers:GetChildren()) do
        for mgName, meshId in pairs(MG_MESHES) do
            if t.Name:find(mgName) and not t:FindFirstChild("CustomMGDone") then
                local mark = Instance.new("BoolValue", t)
                mark.Name = "CustomMGDone"

                local anchor = t:FindFirstChild("Gun", true) or t:FindFirstChild("Turel", true) or t:FindFirstChild("Up", true) or t:FindFirstChild("HumanoidRootPart")
                if anchor then
                    -- Прячем родные меши пушки
                    for _, p in ipairs(t:GetDescendants()) do
                        if p:IsA("MeshPart") and p.Name:find("Gun") then
                            p.Transparency = 1
                        end
                    end

                    -- Ставим кастомный меш
                    local customP = Instance.new("Part")
                    customP.Name = "CustomMGVisual"
                    customP.CanCollide = false
                    customP.Massless = true
                    customP.CFrame = anchor.CFrame
                    customP.Parent = t

                    local sm = Instance.new("SpecialMesh", customP)
                    sm.MeshType = Enum.MeshType.FileMesh
                    sm.MeshId = "rbxassetid://" .. meshId
                    sm.Scale = Vector3.new(1.2, 1.2, 1.2)

                    local w = Instance.new("WeldConstraint")
                    w.Part0 = customP
                    w.Part1 = anchor
                    w.Parent = customP
                end
            end
        end
    end
end

