-- // Подсчет общей стоимости апгрейда и продажи всех башен
local function getTowersFinancials()
    if not SharedClass then return 0, 0, 0, 0 end
    local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
    if not tpFolder then return 0, 0, 0, 0 end

    local totalSell = 0
    local totalUpgrade = 0
    local ownedCount = 0
    local upgradableCount = 0

    for _, tp in ipairs(tpFolder:GetChildren()) do
        local uid = tp:GetAttribute("uid")
        if uid then
            local obj = SharedClass.GetById(uid)
            if obj and obj.isOwner then
                ownedCount = ownedCount + 1
                totalSell = totalSell + (obj.costSell or 0)

                local nextStar = (obj.starCount or 0) + 1
                local data = towerStatsCache[obj.name]
                if data then
                    local sData = data["star" .. nextStar]
                    if sData and sData.cost then
                        totalUpgrade = totalUpgrade + sData.cost
                        upgradableCount = upgradableCount + 1
                    end
                end
            end
        end
    end
    return totalUpgrade, totalSell, ownedCount, upgradableCount
end

