local function applySkin(m, sChar)
    if not m or not m:IsA("Model") then return end
    if Players:GetPlayerFromCharacter(m) then return end
    local root = m:FindFirstChild("HumanoidRootPart")
    local tHead = m:FindFirstChild("Head")
    if not root or not tHead then return end

    if not skinBackups[m] then
        local b = { parts = {}, tHeadTrans = tHead.Transparency }
        for _, p in ipairs(m:GetChildren()) do
            if p:IsA("Accessory") or p:IsA("Shirt") or p:IsA("Pants") or p:IsA("ShirtGraphic") or p:IsA("CharacterMesh") then
                b.parts[p] = p.Parent
            end
        end
        skinBackups[m] = b
    end

    for p in pairs(skinBackups[m].parts) do
        if p.Parent == m then p.Parent = nil end
    end

    tHead.Transparency = 1

    local sHead = sChar:FindFirstChild("Head")
    for _, acc in ipairs(sChar:GetChildren()) do
        if acc:IsA("Accessory") then
            local handle = acc:FindFirstChild("Handle")
            if handle and not m:FindFirstChild("Fake_" .. acc.Name) then
                local c = handle:Clone()
                c.Name = "Fake_" .. acc.Name
                c.CanCollide = false
                c.Anchored = false
                c.Massless = true
                c.Parent = m

                local attach = handle:FindFirstChildOfClass("Attachment")
                local targetPart = tHead
                local targetAttach = nil

                if attach then
                    local pName = attach.Name:gsub("Attachment", "")
                    targetPart = m:FindFirstChild(pName) or tHead
                    targetAttach = targetPart:FindFirstChild(attach.Name)
                end

                local weld = Instance.new("Weld")
                weld.Part0 = targetPart
                weld.Part1 = c
                if attach and targetAttach then
                    weld.C0 = targetAttach.CFrame
                    weld.C1 = attach.CFrame
                elseif sHead then
                    weld.C0 = CFrame.new(0, 0.5, 0)
                    weld.C1 = (sHead.CFrame:Inverse() * handle.CFrame)
                end
                weld.Parent = c
            end
        end
    end

    local shirt = m:FindFirstChildOfClass("Shirt") or Instance.new("Shirt", m)
    shirt.ShirtTemplate = SHIRT_ID
    local pants = m:FindFirstChildOfClass("Pants") or Instance.new("Pants", m)
    pants.PantsTemplate = PANTS_ID
end

local function revertSkin(m)
    local b = skinBackups[m]
    if not b then return end
    for _, ch in ipairs(m:GetChildren()) do
        if ch.Name:find("Fake_") then ch:Destroy() end
    end
    local tHead = m:FindFirstChild("Head")
    if tHead then tHead.Transparency = b.tHeadTrans end
    for p, parent in pairs(b.parts) do
        p.Parent = parent
    end
    skinBackups[m] = nil
end

