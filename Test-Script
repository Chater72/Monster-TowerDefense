local function findTowerNear(x, z, maxDist)
    if not SharedClass then return nil end
    local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
    if not tpFolder then return nil end
    local bestObj = nil
    local minDist = maxDist or 6

    for _, tp in ipairs(tpFolder:GetChildren()) do
        local uid = tp:GetAttribute("uid")
        if uid then
            local obj = SharedClass.GetById(uid)
            if obj and obj.isOwner and obj.position then
                local dist = math.sqrt((obj.position.X - x)^2 + (obj.position.Z - z)^2)
                if dist < minDist then
                    minDist = dist
                    bestObj = obj
                end
            end
        end
    end
    return bestObj
end

local TACTICS_DIR = "mtd_tactics"
if not isfolder(TACTICS_DIR) then
    pcall(makefolder, TACTICS_DIR)
end

local function sanitizeName(name)
    if not name or name == "" then return "Tactic_1" end
    name = name:gsub("[^%w_%-%s]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then name = "Tactic_1" end
    return name
end

local function getTacticList()
    local list = {}
    if not isfolder(TACTICS_DIR) then
        pcall(makefolder, TACTICS_DIR)
    end
    local files = pcall(listfiles, TACTICS_DIR) and listfiles(TACTICS_DIR) or {}
    for _, path in ipairs(files) do
        local n = path:match("([^/\\]+)%.json$")
        if n then
            table.insert(list, n)
        end
    end
    if #list == 0 then
        table.insert(list, "Tactic_1")
    end
    return list
end

local function saveTactic(name)
    if #MacroActions == 0 then
        return false, "Macro is empty! Nothing to save."
    end
    local safeName = sanitizeName(name)
    local fullPath = TACTICS_DIR .. "/" .. safeName .. ".json"
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, MacroActions)
    if not ok or not encoded then
        return false, "JSON encoding error!"
    end
    local writeOk, err = pcall(writefile, fullPath, encoded)
    if not writeOk then
        return false, "Write error: " .. tostring(err)
    end
    return true, "Tactic '" .. safeName .. "' saved (" .. #MacroActions .. " actions)!"
end

local function loadTactic(name)
    local safeName = sanitizeName(name)
    local fullPath = TACTICS_DIR .. "/" .. safeName .. ".json"
    local isf = rawget(getgenv and getgenv() or _G, "isfile") or isfile
    local rf = rawget(getgenv and getgenv() or _G, "readfile") or readfile
    if not isf(fullPath) then
        return false, "Tactic '" .. safeName .. "' not found!"
    end
    local content = rf(fullPath)
    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, content)
    if ok and decoded and type(decoded) == "table" then
        MacroActions = decoded
        currentActionIndex = 1
        PlaybackTowerMap = {}
        StatusPlaybackText = string.format("Loaded %d actions. Ready for Auto Play.", #MacroActions)
        return true, "Loaded " .. #MacroActions .. " actions from '" .. safeName .. "'!"
    end
    return false, "Read error / corrupted file!"
end

local function deleteTactic(name)
    local safeName = sanitizeName(name)
    local fullPath = TACTICS_DIR .. "/" .. safeName .. ".json"
    local isf = rawget(getgenv and getgenv() or _G, "isfile") or isfile
    local df = rawget(getgenv and getgenv() or _G, "delfile") or delfile
    if not isf(fullPath) then
        return false, "File does not exist!"
    end
    pcall(df, fullPath)
    return true, "Tactic '" .. safeName .. "' deleted!"
end

local function startRecording()
    MacroActions = {}
    TrackedTowers = {}
    nextMacroIdCounter = 1
    State.MacroRecording = true
    State.MacroPlaying = false

    -- Register already placed towers for tracking only (do not add as BUILD actions)
    local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
    if tpFolder and SharedClass then
        for _, tp in ipairs(tpFolder:GetChildren()) do
            local uid = tp:GetAttribute("uid")
            if uid then
                local obj = SharedClass.GetById(uid)
                if obj and obj.isOwner and obj.position then
                    local id = nextMacroIdCounter
                    nextMacroIdCounter = nextMacroIdCounter + 1
                    TrackedTowers[uid] = {
                        macroId = id,
                        name = obj.name,
                        x = obj.position.X,
                        z = obj.position.Z,
                        star = obj.starCount or 0
                    }
                end
            end
        end
    end
end

local function stopRecording()
    State.MacroRecording = false
end

local function startPlayback()
    if #MacroActions == 0 then
        StatusPlaybackText = "⚠️ Macro is empty! Record or load first."
        return
    end
    PlaybackTowerMap = {}
    currentActionIndex = 1
    State.MacroPlaying = true
    State.MacroRecording = false
    StatusPlaybackText = "▶️ Playback started..."

    if State.MacroAutoMaxSpeed then
        setMaxSpeed()
    end
end

local function stopPlayback()
    State.MacroPlaying = false
    StatusPlaybackText = "⏹️ Playback stopped."
end

-- Tower recording loop
task.spawn(function()
    while true do
        task.wait(0.2)
        if State.MacroRecording and SharedClass then
            local currentWave = getCurrentWave()
            local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
                        local currentObjects = {}
            local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
            if tpFolder and SharedClass then
                for _, tp in ipairs(tpFolder:GetChildren()) do
                    local uid = tp:GetAttribute("uid")
                    if uid then
                        local obj = SharedClass.GetById(uid)
                        if obj and obj.isOwner and obj.position then
                            currentObjects[uid] = obj
                        end
                    end
                end
            end

            -- Step 1: Detect branch upgrades where UID changed at the same position (within 4 studs)
            for oldUid, tracked in pairs(TrackedTowers) do
                if not currentObjects[oldUid] then
                    local matchedNewUid, matchedNewObj = nil, nil
                    for newUid, newObj in pairs(currentObjects) do
                        if not TrackedTowers[newUid] then
                            local dx = newObj.position.X - tracked.x
                            local dz = newObj.position.Z - tracked.z
                            if (dx*dx + dz*dz) < 16 then
                                matchedNewUid = newUid
                                matchedNewObj = newObj
                                break
                            end
                        end
                    end

                    if matchedNewUid and matchedNewObj then
                        -- BRANCH UPGRADE detected! Replace tracking without selling or rebuilding!
                        local oldName = tracked.name
                        local branchName = matchedNewObj.name
                        local newStar = matchedNewObj.starCount or 0

                        TrackedTowers[matchedNewUid] = {
                            macroId = tracked.macroId,
                            name = branchName,
                            x = matchedNewObj.position.X,
                            z = matchedNewObj.position.Z,
                            star = newStar
                        }
                        TrackedTowers[oldUid] = nil

                        table.insert(MacroActions, {
                            type = "UPGRADE_BRANCH",
                            macroId = tracked.macroId,
                            branchName = branchName,
                            fromName = oldName,
                            x = matchedNewObj.position.X,
                            z = matchedNewObj.position.Z,
                            wave = currentWave
                        })
                    else
                        -- Genuine SELL
                        table.insert(MacroActions, {
                            type = "SELL",
                            macroId = tracked.macroId,
                            wave = currentWave
                        })
                        TrackedTowers[oldUid] = nil
                    end
                end
            end

            -- Step 2: Register genuine builds or in-place upgrades
            for uid, obj in pairs(currentObjects) do
                if not TrackedTowers[uid] then
                    local id = nextMacroIdCounter
                    nextMacroIdCounter = nextMacroIdCounter + 1
                    TrackedTowers[uid] = {
                        macroId = id,
                        name = obj.name,
                        x = obj.position.X,
                        z = obj.position.Z,
                        star = obj.starCount or 0
                    }
                    table.insert(MacroActions, {
                        type = "BUILD",
                        macroId = id,
                        name = obj.name,
                        x = obj.position.X,
                        z = obj.position.Z,
                        wave = currentWave
                    })
                else
                    local tracked = TrackedTowers[uid]
                    local curName = obj.name
                    local curStar = obj.starCount or 0

                    if curName and tracked.name and curName ~= tracked.name then
                        local oldName = tracked.name
                        tracked.name = curName
                        tracked.star = curStar

                        table.insert(MacroActions, {
                            type = "UPGRADE_BRANCH",
                            macroId = tracked.macroId,
                            branchName = curName,
                            fromName = oldName,
                            x = obj.position.X,
                            z = obj.position.Z,
                            wave = currentWave
                        })
                    elseif curStar > tracked.star then
                        tracked.star = curStar
                        table.insert(MacroActions, {
                            type = "UPGRADE_STAR",
                            macroId = tracked.macroId,
                            star = curStar,
                            wave = currentWave
                        })
                    end
                end
            end
        end
    end
end)

-- Macro playback loop
task.spawn(function()
    while true do
        task.wait(0.35)
        if State.MacroPlaying then
            if State.MacroAutoMaxSpeed and curWave ~= lastSetSpeedWave then
                lastSetSpeedWave = curWave
                setMaxSpeed()
            end

            if currentActionIndex > #MacroActions then
                StatusPlaybackText = "✅ All actions completed!"
                if State.MacroAutoLoop and getCurrentWave() == 1 and currentActionIndex > 1 then
                    task.wait(2)
                    startPlayback()
                end
            else
                local action = MacroActions[currentActionIndex]
                local curWave = getCurrentWave()
                local curMoney = getMoney()

                if curWave < action.wave then
                    StatusPlaybackText = string.format("⏳ Waiting for wave %d (current: %d) [%d/%d]", action.wave, curWave, currentActionIndex, #MacroActions)
                else
                    if action.type == "BUILD" then
                        local cost = getTowerBuildCost(action.name)
                        if curMoney < cost then
                            StatusPlaybackText = string.format("💰 Saving for %s: $%d / $%d (wave %d)", action.name, curMoney, cost, action.wave)
                        else
                            StatusPlaybackText = string.format("🔨 Placing %s at (%.0f, %.0f)...", action.name, action.x, action.z)
                            local placed = false
                            pcall(function()
                                local ConstructionService = require(ReplicatedStorage.Services.ConstructionService)
                                if ConstructionService and ConstructionService.ClientBuild then
                                    ConstructionService.ClientBuild(Vector2.new(action.x, action.z), action.name)
                                    placed = true
                                end
                            end)

                            if not placed then
                                pcall(function()
                                    local net = require(ReplicatedStorage.staticModules.generics.net)
                                    local ch = net.Get("TowerBuilding")
                                    if ch then
                                        ch:Fire(Vector2.new(action.x, action.z), action.name)
                                        placed = true
                                    end
                                end)
                            end

                            if not placed then
                                local tb = ReplicatedStorage.channels:FindFirstChild("TowerBuilding")
                                if tb then
                                    tb:FireServer(Vector2.new(action.x, action.z), action.name)
                                end
                            end
                            task.wait(0.5)

                            local newTower = findTowerNear(action.x, action.z, 6)
                            if newTower then
                                PlaybackTowerMap[action.macroId] = newTower
                            end
                            currentActionIndex = currentActionIndex + 1
                        end
                    elseif action.type == "UPGRADE_BRANCH" then
                        local targetTower = PlaybackTowerMap[action.macroId]
                        if not targetTower or targetTower.isDestroyed then
                            targetTower = findTowerNear(action.x or 0, action.z or 0, 10)
                        end

                        if not targetTower or targetTower.isDestroyed then
                            currentActionIndex = currentActionIndex + 1
                        else
                            local branchCost = getBranchCost(action.branchName)
                            if curMoney < branchCost then
                                StatusPlaybackText = string.format("💰 Saving for branch %s (#%d): $%d / $%d (wave %d)", action.branchName, action.macroId, curMoney, branchCost, action.wave)
                            else
                                StatusPlaybackText = string.format("🌟 Upgrading branch %s for tower #%d...", action.branchName, action.macroId)
                                doUpgradeBranch(targetTower.model, action.branchName)
                                task.wait(0.5)

                                local updatedTower = findTowerNear(action.x or 0, action.z or 0, 10)
                                if updatedTower then
                                    PlaybackTowerMap[action.macroId] = updatedTower
                                end
                                currentActionIndex = currentActionIndex + 1
                            end
                        end
                    elseif action.type == "UPGRADE_STAR" then
                        local targetTower = PlaybackTowerMap[action.macroId]
                        if not targetTower or targetTower.isDestroyed then
                            targetTower = findTowerNear(action.x or 0, action.z or 0, 10)
                        end

                        if not targetTower or targetTower.isDestroyed then
                            currentActionIndex = currentActionIndex + 1
                        else
                            local starCost = targetTower.priceHandler and targetTower.priceHandler:GetStarCost() or 150
                            if curMoney < starCost then
                                StatusPlaybackText = string.format("💰 Saving for upgrade #%d: $%d / $%d (wave %d)", action.macroId, curMoney, starCost, action.wave)
                            else
                                StatusPlaybackText = string.format("⚡ Upgrading tower #%d (star %d)...", action.macroId, action.star)
                                doUpgrade(targetTower.model)
                                task.wait(0.4)
                                currentActionIndex = currentActionIndex + 1
                            end
                        end
                    elseif action.type == "SELL" then
                        local targetTower = PlaybackTowerMap[action.macroId]
                        if targetTower and not targetTower.isDestroyed then
                            StatusPlaybackText = string.format("🗑️ Selling tower #%d (wave %d)...", action.macroId, action.wave)
                            doSell(targetTower.model)
                            task.wait(0.3)
                        end
                        currentActionIndex = currentActionIndex + 1
                    elseif action.type == "SKIP" then
                        StatusPlaybackText = string.format("⏩ Skipping wave %d...", action.wave)
                        triggerSkip()
                        task.wait(0.3)
                        currentActionIndex = currentActionIndex + 1
                    end
                end
            end
        end
    end
end)

