-- // Determine branch upgrade cost
local function getBranchCost(branchName)
    local cost = 0
    pcall(function()
        local ConstructionService = require(ReplicatedStorage.Services.ConstructionService)
        cost = ConstructionService.GetTowerCost(branchName, Players.LocalPlayer)
    end)
    if not cost or cost <= 0 then
        local data = towerStatsCache[branchName]
        if data and data.price then
            cost = data.price
        end
    end
    return cost > 0 and cost or 300
end

-- // Upgrade tower to branch
local function doUpgradeBranch(targetModel, branchName)
    if not targetModel or not branchName then return false end

    -- 1. Find SharedClass object
    local targetTower = nil
    if SharedClass then
        local tpFolder = Workspace:FindFirstChild("Towers") and Workspace.Towers:FindFirstChild("TouchParts")
        if tpFolder then
            for _, tp in ipairs(tpFolder:GetChildren()) do
                local uid = tp:GetAttribute("uid")
                if uid then
                    local obj = SharedClass.GetById(uid)
                    if obj and (obj.model == targetModel or obj.instance == targetModel) then
                        targetTower = obj
                        break
                    end
                end
            end
        end
    end

    -- 2. Direct call to UpgradeTowerServer / UpgradeTowerClient on object
    if targetTower then
        pcall(function()
            if targetTower.UpgradeTowerClient then
                targetTower:UpgradeTowerClient(branchName)
            else
                targetTower:RemoteCall("UpgradeTowerServer", branchName)
            end
        end)
    end

    -- 3. Select tower and emulate click in UI
    selectTower(targetModel)
    task.wait(0.04)

    local mainGui = pgui:FindFirstChild("MainGui")
    if mainGui then
        local upgrader = mainGui:FindFirstChild("TowerFrame") and mainGui.TowerFrame:FindFirstChild("FrameUpgrader")
        local frameUpg = upgrader and upgrader:FindFirstChild("FrameUpgrade")
        local switchBtn = frameUpg and frameUpg:FindFirstChild("upgrade")
        if switchBtn and switchBtn.Visible then
            fireClick(switchBtn)
            task.wait(0.04)
        end

        local tcMod = nil
        pcall(function()
            if _G.GuiService and _G.GuiService.GetModule then
                tcMod = _G.GuiService.GetModule("TowerChoiceModule")
            end
            if not tcMod then
                local tc = mainGui:FindFirstChild("TowerChoiceModule", true)
                if tc then tcMod = require(tc) end
            end
        end)

        local branchCost = getBranchCost(branchName)
        if tcMod and tcMod.ClickButton then
            pcall(tcMod.ClickButton, branchName, branchCost)
        end

        local tcFrame = upgrader and upgrader:FindFirstChild("TowerChoiceUpgrade")
        if tcFrame then
            for _, ch in ipairs(tcFrame:GetChildren()) do
                if ch:IsA("Frame") and ch:FindFirstChild("ChoiceButton") then
                    local costLbl = ch:FindFirstChild("TextCost")
                    local cVal = costLbl and parseNumber(costLbl.Text) or 0
                    if ch.Name == branchName or (branchCost > 0 and cVal == branchCost) then
                        fireClick(ch.ChoiceButton)
                        break
                    end
                end
            end
        end

        local tf = mainGui:FindFirstChild("TowerFrame")
        if tf then
            for _, d in ipairs(tf:GetDescendants()) do
                if d:IsA("TextButton") or d:IsA("ImageButton") then
                    local pName = d.Parent and d.Parent.Name or ""
                    if d.Name == branchName or pName == branchName or d.Name == "ChoiceButton" then
                        fireClick(d)
                    end
                end
            end
        end
    end

    return true
end

